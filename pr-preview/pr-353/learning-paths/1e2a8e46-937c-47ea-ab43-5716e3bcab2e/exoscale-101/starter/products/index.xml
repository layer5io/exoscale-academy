    <item>
      <title>Overview</title>
      <link>https://layer5io.github.io/exoscale-academy/pr-preview/pr-353/learning-paths/1e2a8e46-937c-47ea-ab43-5716e3bcab2e/exoscale-101/starter/products/overview/overview/</link>
